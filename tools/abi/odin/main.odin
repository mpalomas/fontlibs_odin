// Prints the size and the field offsets of the Odin structs of the bindings, as tools/abi/abi_check.c prints the C structs', with
// the C names: tools/abi/check.sh compares the two outputs.
package main

import "core:fmt"
import ft "../../../freetype"
import hb "../../../harfbuzz"

size :: proc(name: string, bytes: int) {
	fmt.printfln("%s size %d", name, bytes)
}

offset :: proc(name: string, bytes: uintptr) {
	fmt.printfln("%s %d", name, bytes)
}

main :: proc() {
	size("FT_Vector", size_of(ft.Vector))
	offset("FT_Vector.x", offset_of(ft.Vector, x))
	offset("FT_Vector.y", offset_of(ft.Vector, y))

	size("FT_BBox", size_of(ft.BBox))
	offset("FT_BBox.xMin", offset_of(ft.BBox, x_min))
	offset("FT_BBox.yMin", offset_of(ft.BBox, y_min))
	offset("FT_BBox.xMax", offset_of(ft.BBox, x_max))
	offset("FT_BBox.yMax", offset_of(ft.BBox, y_max))

	size("FT_Matrix", size_of(ft.Matrix))
	offset("FT_Matrix.xx", offset_of(ft.Matrix, xx))
	offset("FT_Matrix.xy", offset_of(ft.Matrix, xy))
	offset("FT_Matrix.yx", offset_of(ft.Matrix, yx))
	offset("FT_Matrix.yy", offset_of(ft.Matrix, yy))

	size("FT_Generic", size_of(ft.Generic))
	offset("FT_Generic.data", offset_of(ft.Generic, data))
	offset("FT_Generic.finalizer", offset_of(ft.Generic, finalizer))

	size("FT_ListRec", size_of(ft.List_Rec))
	offset("FT_ListRec.head", offset_of(ft.List_Rec, head))
	offset("FT_ListRec.tail", offset_of(ft.List_Rec, tail))

	size("FT_Glyph_Metrics", size_of(ft.Glyph_Metrics))
	offset("FT_Glyph_Metrics.width", offset_of(ft.Glyph_Metrics, width))
	offset("FT_Glyph_Metrics.height", offset_of(ft.Glyph_Metrics, height))
	offset("FT_Glyph_Metrics.horiBearingX", offset_of(ft.Glyph_Metrics, hori_bearing_x))
	offset("FT_Glyph_Metrics.horiBearingY", offset_of(ft.Glyph_Metrics, hori_bearing_y))
	offset("FT_Glyph_Metrics.horiAdvance", offset_of(ft.Glyph_Metrics, hori_advance))
	offset("FT_Glyph_Metrics.vertBearingX", offset_of(ft.Glyph_Metrics, vert_bearing_x))
	offset("FT_Glyph_Metrics.vertBearingY", offset_of(ft.Glyph_Metrics, vert_bearing_y))
	offset("FT_Glyph_Metrics.vertAdvance", offset_of(ft.Glyph_Metrics, vert_advance))

	size("FT_Size_Metrics", size_of(ft.Size_Metrics))
	offset("FT_Size_Metrics.x_ppem", offset_of(ft.Size_Metrics, x_ppem))
	offset("FT_Size_Metrics.y_ppem", offset_of(ft.Size_Metrics, y_ppem))
	offset("FT_Size_Metrics.x_scale", offset_of(ft.Size_Metrics, x_scale))
	offset("FT_Size_Metrics.y_scale", offset_of(ft.Size_Metrics, y_scale))
	offset("FT_Size_Metrics.ascender", offset_of(ft.Size_Metrics, ascender))
	offset("FT_Size_Metrics.descender", offset_of(ft.Size_Metrics, descender))
	offset("FT_Size_Metrics.height", offset_of(ft.Size_Metrics, height))
	offset("FT_Size_Metrics.max_advance", offset_of(ft.Size_Metrics, max_advance))

	size("FT_SizeRec", size_of(ft.Size_Rec))
	offset("FT_SizeRec.face", offset_of(ft.Size_Rec, face))
	offset("FT_SizeRec.generic", offset_of(ft.Size_Rec, generic))
	offset("FT_SizeRec.metrics", offset_of(ft.Size_Rec, metrics))
	offset("FT_SizeRec.internal", offset_of(ft.Size_Rec, internal))

	size("FT_Bitmap", size_of(ft.Bitmap))
	offset("FT_Bitmap.rows", offset_of(ft.Bitmap, rows))
	offset("FT_Bitmap.width", offset_of(ft.Bitmap, width))
	offset("FT_Bitmap.pitch", offset_of(ft.Bitmap, pitch))
	offset("FT_Bitmap.buffer", offset_of(ft.Bitmap, buffer))
	offset("FT_Bitmap.num_grays", offset_of(ft.Bitmap, num_grays))
	offset("FT_Bitmap.pixel_mode", offset_of(ft.Bitmap, pixel_mode))
	offset("FT_Bitmap.palette_mode", offset_of(ft.Bitmap, palette_mode))
	offset("FT_Bitmap.palette", offset_of(ft.Bitmap, palette))

	size("FT_Outline", size_of(ft.Outline))
	offset("FT_Outline.n_contours", offset_of(ft.Outline, n_contours))
	offset("FT_Outline.n_points", offset_of(ft.Outline, n_points))
	offset("FT_Outline.points", offset_of(ft.Outline, points))
	offset("FT_Outline.tags", offset_of(ft.Outline, tags))
	offset("FT_Outline.contours", offset_of(ft.Outline, contours))
	offset("FT_Outline.flags", offset_of(ft.Outline, flags))

	size("FT_GlyphSlotRec", size_of(ft.Glyph_Slot_Rec))
	offset("FT_GlyphSlotRec.library", offset_of(ft.Glyph_Slot_Rec, library))
	offset("FT_GlyphSlotRec.face", offset_of(ft.Glyph_Slot_Rec, face))
	offset("FT_GlyphSlotRec.next", offset_of(ft.Glyph_Slot_Rec, next))
	offset("FT_GlyphSlotRec.glyph_index", offset_of(ft.Glyph_Slot_Rec, glyph_index))
	offset("FT_GlyphSlotRec.generic", offset_of(ft.Glyph_Slot_Rec, generic))
	offset("FT_GlyphSlotRec.metrics", offset_of(ft.Glyph_Slot_Rec, metrics))
	offset("FT_GlyphSlotRec.linearHoriAdvance", offset_of(ft.Glyph_Slot_Rec, linear_hori_advance))
	offset("FT_GlyphSlotRec.linearVertAdvance", offset_of(ft.Glyph_Slot_Rec, linear_vert_advance))
	offset("FT_GlyphSlotRec.advance", offset_of(ft.Glyph_Slot_Rec, advance))
	offset("FT_GlyphSlotRec.format", offset_of(ft.Glyph_Slot_Rec, format))
	offset("FT_GlyphSlotRec.bitmap", offset_of(ft.Glyph_Slot_Rec, bitmap))
	offset("FT_GlyphSlotRec.bitmap_left", offset_of(ft.Glyph_Slot_Rec, bitmap_left))
	offset("FT_GlyphSlotRec.bitmap_top", offset_of(ft.Glyph_Slot_Rec, bitmap_top))
	offset("FT_GlyphSlotRec.outline", offset_of(ft.Glyph_Slot_Rec, outline))
	offset("FT_GlyphSlotRec.num_subglyphs", offset_of(ft.Glyph_Slot_Rec, num_subglyphs))
	offset("FT_GlyphSlotRec.subglyphs", offset_of(ft.Glyph_Slot_Rec, subglyphs))
	offset("FT_GlyphSlotRec.control_data", offset_of(ft.Glyph_Slot_Rec, control_data))
	offset("FT_GlyphSlotRec.control_len", offset_of(ft.Glyph_Slot_Rec, control_len))
	offset("FT_GlyphSlotRec.lsb_delta", offset_of(ft.Glyph_Slot_Rec, lsb_delta))
	offset("FT_GlyphSlotRec.rsb_delta", offset_of(ft.Glyph_Slot_Rec, rsb_delta))
	offset("FT_GlyphSlotRec.other", offset_of(ft.Glyph_Slot_Rec, other))
	offset("FT_GlyphSlotRec.internal", offset_of(ft.Glyph_Slot_Rec, internal))

	size("FT_FaceRec", size_of(ft.Face_Rec))
	offset("FT_FaceRec.num_faces", offset_of(ft.Face_Rec, num_faces))
	offset("FT_FaceRec.face_index", offset_of(ft.Face_Rec, face_index))
	offset("FT_FaceRec.face_flags", offset_of(ft.Face_Rec, face_flags))
	offset("FT_FaceRec.style_flags", offset_of(ft.Face_Rec, style_flags))
	offset("FT_FaceRec.num_glyphs", offset_of(ft.Face_Rec, num_glyphs))
	offset("FT_FaceRec.family_name", offset_of(ft.Face_Rec, family_name))
	offset("FT_FaceRec.style_name", offset_of(ft.Face_Rec, style_name))
	offset("FT_FaceRec.num_fixed_sizes", offset_of(ft.Face_Rec, num_fixed_sizes))
	offset("FT_FaceRec.available_sizes", offset_of(ft.Face_Rec, available_sizes))
	offset("FT_FaceRec.num_charmaps", offset_of(ft.Face_Rec, num_charmaps))
	offset("FT_FaceRec.charmaps", offset_of(ft.Face_Rec, charmaps))
	offset("FT_FaceRec.generic", offset_of(ft.Face_Rec, generic))
	offset("FT_FaceRec.bbox", offset_of(ft.Face_Rec, bbox))
	offset("FT_FaceRec.units_per_EM", offset_of(ft.Face_Rec, units_per_em))
	offset("FT_FaceRec.ascender", offset_of(ft.Face_Rec, ascender))
	offset("FT_FaceRec.descender", offset_of(ft.Face_Rec, descender))
	offset("FT_FaceRec.height", offset_of(ft.Face_Rec, height))
	offset("FT_FaceRec.max_advance_width", offset_of(ft.Face_Rec, max_advance_width))
	offset("FT_FaceRec.max_advance_height", offset_of(ft.Face_Rec, max_advance_height))
	offset("FT_FaceRec.underline_position", offset_of(ft.Face_Rec, underline_position))
	offset("FT_FaceRec.underline_thickness", offset_of(ft.Face_Rec, underline_thickness))
	offset("FT_FaceRec.glyph", offset_of(ft.Face_Rec, glyph))
	offset("FT_FaceRec.size", offset_of(ft.Face_Rec, size))
	offset("FT_FaceRec.charmap", offset_of(ft.Face_Rec, charmap))
	offset("FT_FaceRec.driver", offset_of(ft.Face_Rec, driver))
	offset("FT_FaceRec.memory", offset_of(ft.Face_Rec, memory))
	offset("FT_FaceRec.stream", offset_of(ft.Face_Rec, stream))
	offset("FT_FaceRec.sizes_list", offset_of(ft.Face_Rec, sizes_list))
	offset("FT_FaceRec.autohint", offset_of(ft.Face_Rec, autohint))
	offset("FT_FaceRec.extensions", offset_of(ft.Face_Rec, extensions))
	offset("FT_FaceRec.internal", offset_of(ft.Face_Rec, internal))

	size("FT_Error", size_of(ft.Error))
	size("FT_Glyph_Format", size_of(ft.Glyph_Format))
	size("FT_Render_Mode", size_of(ft.Render_Mode))
	size("FT_Int32", size_of(ft.Load_Flags))

	size("hb_glyph_info_t", size_of(hb.Glyph_Info))
	offset("hb_glyph_info_t.codepoint", offset_of(hb.Glyph_Info, codepoint))
	offset("hb_glyph_info_t.mask", offset_of(hb.Glyph_Info, mask))
	offset("hb_glyph_info_t.cluster", offset_of(hb.Glyph_Info, cluster))
	offset("hb_glyph_info_t.var1", offset_of(hb.Glyph_Info, var1))
	offset("hb_glyph_info_t.var2", offset_of(hb.Glyph_Info, var2))

	size("hb_glyph_position_t", size_of(hb.Glyph_Position))
	offset("hb_glyph_position_t.x_advance", offset_of(hb.Glyph_Position, x_advance))
	offset("hb_glyph_position_t.y_advance", offset_of(hb.Glyph_Position, y_advance))
	offset("hb_glyph_position_t.x_offset", offset_of(hb.Glyph_Position, x_offset))
	offset("hb_glyph_position_t.y_offset", offset_of(hb.Glyph_Position, y_offset))
	offset("hb_glyph_position_t.var", offset_of(hb.Glyph_Position, var))

	size("hb_glyph_extents_t", size_of(hb.Glyph_Extents))
	offset("hb_glyph_extents_t.x_bearing", offset_of(hb.Glyph_Extents, x_bearing))
	offset("hb_glyph_extents_t.y_bearing", offset_of(hb.Glyph_Extents, y_bearing))
	offset("hb_glyph_extents_t.width", offset_of(hb.Glyph_Extents, width))
	offset("hb_glyph_extents_t.height", offset_of(hb.Glyph_Extents, height))

	size("hb_feature_t", size_of(hb.Feature))
	offset("hb_feature_t.tag", offset_of(hb.Feature, tag))
	offset("hb_feature_t.value", offset_of(hb.Feature, value))
	offset("hb_feature_t.start", offset_of(hb.Feature, start))
	offset("hb_feature_t.end", offset_of(hb.Feature, end))

	size("hb_variation_t", size_of(hb.Variation))
	offset("hb_variation_t.tag", offset_of(hb.Variation, tag))
	offset("hb_variation_t.value", offset_of(hb.Variation, value))

	size("hb_raster_extents_t", size_of(hb.Raster_Extents))
	offset("hb_raster_extents_t.x_origin", offset_of(hb.Raster_Extents, x_origin))
	offset("hb_raster_extents_t.y_origin", offset_of(hb.Raster_Extents, y_origin))
	offset("hb_raster_extents_t.width", offset_of(hb.Raster_Extents, width))
	offset("hb_raster_extents_t.height", offset_of(hb.Raster_Extents, height))
	offset("hb_raster_extents_t.stride", offset_of(hb.Raster_Extents, stride))

	size("hb_bool_t", size_of(hb.Bool))
	size("hb_codepoint_t", size_of(hb.Codepoint))
	size("hb_position_t", size_of(hb.Position))
	size("hb_tag_t", size_of(hb.Tag))
	size("hb_color_t", size_of(hb.Color))
	size("hb_direction_t", size_of(hb.Direction))
	size("hb_memory_mode_t", size_of(hb.Memory_Mode))
	size("hb_raster_format_t", size_of(hb.Raster_Format))
}
